# Proveedor activo: openai | gemini | openrouter
AI_PROVIDER=gemini

# Modelo opcional.
# Si queda vacío, la aplicación utilizará el modelo por defecto del proveedor.
AI_MODEL=

# API Keys
# Completar solamente la clave correspondiente al proveedor que se utilice.
OPENAI_API_KEY=tu-openai-api-key
GEMINI_API_KEY=tu-gemini-api-key
OPENROUTER_API_KEY=tu-openrouter-api-key
