# ============================================================
# Configuración activa
# ============================================================
# Descomentá/configurá un único bloque a la vez.
# AI_MODEL: modelo de chat (Labs 01-06 y futuros labs con chat).
# AI_EMBEDDING_MODEL: modelo de embeddings (obligatorio en Lab 07).
# Ambos modelos comparten AI_PROVIDER, AI_API_KEY y AI_URL.

# GEMINI
AI_PROVIDER=gemini
AI_MODEL=gemini-3.5-flash-lite
AI_EMBEDDING_MODEL=gemini-embedding-001
AI_API_KEY=tu-api-key
AI_URL=https://generativelanguage.googleapis.com/v1beta/openai/

